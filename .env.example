# ── FastAPI RAG Service ─────────────────────────────────────────────────────
# Teacher-isolated RAG using Gemini + ChromaDB

# ── Gemini ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Backend ────────────────────────────────────────────────────────────────
# The NestJS backend uploads directory — mounted or symlinked
UPLOADS_ROOT=../backend/uploads

# ── Service ────────────────────────────────────────────────────────────────
RAG_HOST=0.0.0.0
RAG_PORT=8000
