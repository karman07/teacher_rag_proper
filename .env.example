# ── FastAPI RAG Service ─────────────────────────────────────────────────────
# Teacher-isolated RAG using Gemini + ChromaDB

# ── Gemini ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db

# ── Backend ────────────────────────────────────────────────────────────────
# The NestJS backend uploads directory — mounted or symlinked
UPLOADS_ROOT=../backend/uploads

# ── Service ────────────────────────────────────────────────────────────────
RAG_HOST=0.0.0.0
RAG_PORT=8000
IMAGE_CAPTION_BACKEND=gemini
PDF_MAX_PAGES=20
PDF_MAX_IMAGES_PER_PAGE=10
PDF_MIN_IMAGE_AREA=40000
PDF_VISION_CONCURRENCY=10
VISION_MODEL_NAME=models/gemini-2.5-flash
    